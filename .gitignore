node_modules
.next
.env.local
.env*.local
.DS_Store
*.log

# Per-machine Claude Code config (settings.json is shared, .local.json is personal)
.claude/settings.local.json
# launch.json hardcodes an absolute node path, so it is machine-specific
.claude/launch.json
# Scratch git worktrees created for isolated agent runs -- each has its own
# .git, never meant to be committed into this repo.
.claude/worktrees/

# Build caches / installer leftovers
tsconfig.tsbuildinfo
*.tmp

# Android build outputs. app/build/ contains generated BuildConfig.java
# which embeds anon-key values from local.properties -- keep it out of
# the repo. The APK we actually ship is copied to public/downloads/
# by our build step.
android/**/build/
android/.gradle/
android/local.properties

# Signing keystores -- MUST NEVER be committed. Losing a Play Store
# keystore = losing the ability to publish updates to that app id
# forever. Back up your keystore + password to a password manager
# and encrypted cloud storage yourself.
*.jks
*.keystore
android/**/*.jks
android/**/*.keystore

.vercel
.env*
